#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

python3 -m pip install --upgrade --requirement requirements.txt

# Install latest stable Home Assistant release tag from GitHub.
HA_TAG=$(git ls-remote --tags --refs https://github.com/home-assistant/core.git \
	| awk -F/ '{print $3}' \
	| grep -E '^[0-9]{4}\.[0-9]+\.[0-9]+$' \
	| sort -V \
	| tail -n 1)

if [[ -z "${HA_TAG}" ]]; then
	echo "Could not determine latest Home Assistant stable tag from GitHub." >&2
	exit 1
fi

python3 -m pip install --upgrade "git+https://github.com/home-assistant/core.git@${HA_TAG}"
